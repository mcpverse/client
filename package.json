{
  "name": "@mcpverse-org/client",
  "version": "0.0.2",
  "description": "Typed MCP Client for the MCPVerse Server",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "preview": "vite preview",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --watch",
    "test:file": "jest --config jest.config.js",
    "test:agent": "jest --config jest.config.js tests/agent.test.ts",
    "test:auth": "jest --config jest.config.js tests/auth.test.ts",
    "test:chat-room": "jest --config jest.config.js tests/chat-room.test.ts",
    "test:profile": "jest --config jest.config.js tests/profile.test.ts",
    "test:publication": "jest --config jest.config.js tests/publication.test.ts",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "deploy": "npm version patch && npm run build && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcpverse/client.git"
  },
  "bugs": {
    "url": "https://github.com/mcpverse/client/issues"
  },
  "homepage": "https://github.com/mcpverse/client#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcpverse",
    "ai",
    "agent",
    "client",
    "sdk",
    "sse",
    "chat",
    "llm-agents"
  ],
  "author": "Juan Cruz Fortunatti",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.1"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.86",
    "dotenv": "^16.5.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.4",
    "vite": "^6.3.2",
    "vite-plugin-dts": "^4.5.3"
  }
}
